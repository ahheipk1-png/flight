# Used by `next build` (production). Committed on purpose: these are
# public URLs, not secrets, and baking them in means a deploy can't
# silently fall back to localhost just because a dashboard env var was
# never set -- which is exactly what happened on the first deploy.
#
# Local dev overrides these via .env.local (gitignored), which Next.js
# always loads with higher precedence.
NEXT_PUBLIC_PROXY_BASE=https://smartflighter-proxy.ahheipk1.workers.dev
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
