# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...opting in for exactly one: .env.production holds only public URLs
# (the Worker proxy and the map tile server), and committing it is what
# stops a deploy silently falling back to localhost. Real secrets stay
# ignored -- nothing sensitive belongs in a NEXT_PUBLIC_* var anyway,
# since those are compiled into the browser bundle.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
