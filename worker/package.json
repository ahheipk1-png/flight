{
  "name": "smartflighter-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:create": "wrangler d1 create smartflighter-db",
    "db:migrations:create": "wrangler d1 migrations create smartflighter-db",
    "db:migrate:local": "wrangler d1 migrations apply smartflighter-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply smartflighter-db --remote",
    "make-admin": "node scripts/make-admin.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
