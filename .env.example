# Copy to .env and adjust. .env is gitignored.
#
# --- Target (Docker) configuration ---
# Once Docker Desktop is installed and `docker compose up -d` is healthy,
# use these:
# DATABASE_URL=postgresql+asyncpg://smartflighter:smartflighter@localhost:5432/smartflighter
# REDIS_URL=redis://localhost:6379/0
#
# --- Current machine reality (no Docker yet) ---
# SQLite + in-memory Redis stand-in. Same code paths, same models (no
# PostGIS-specific column types are used in MVP 1), swap the two lines
# above in when Docker is available -- nothing else changes.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
REDIS_URL=memory://

CORS_ORIGINS=http://localhost:3000
DEFAULT_CURRENCY=CAD

# --- Fare provider ---
# auto = serpapi iff SERPAPI_API_KEY is set, else mock. Explicit override: mock | serpapi
FARE_PROVIDER=auto
SERPAPI_API_KEY=

# --- Budget guard (live SerpApi calls only; mock provider is free) ---
SERPAPI_DAILY_BUDGET=150
SERPAPI_MONTHLY_BUDGET=1500
PER_SEARCH_LIVE_CAP=20
LIVE_DISCOVERY_CALLS_PER_SEARCH=6
VERIFY_TOP_N=8

# --- Cache TTLs (seconds) ---
FARE_CACHE_TTL_DISCOVERY=21600
FARE_CACHE_TTL_VERIFIED=1800
FARE_CACHE_TTL_EMPTY=3600
