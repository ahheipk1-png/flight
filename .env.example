# Copy to .env and adjust. .env is gitignored.
#
# --- Target (Docker) configuration ---
# Once Docker Desktop is installed and `docker compose up -d` is healthy,
# use these:
# DATABASE_URL=postgresql+asyncpg://smartflighter:smartflighter@localhost:5432/smartflighter
# REDIS_URL=redis://localhost:6379/0
#
# --- Current machine reality (no Docker yet) ---
# SQLite + in-memory Redis stand-in. Same code paths, same models (no
# PostGIS-specific column types are used in MVP 1), swap the two lines
# above in when Docker is available -- nothing else changes.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
REDIS_URL=memory://

CORS_ORIGINS=http://localhost:3000
DEFAULT_CURRENCY=CAD

# --- Accounts ---
# Every search runs on the logged-in user's OWN stored key (see "Accounts"
# in README) -- there is no site-wide fallback. Generate a real key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Startup fails loudly if this is blank. Never reuse one key across
# machines/deployments; rotating it makes every already-stored key
# permanently undecryptable.
API_KEY_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=2592000

# --- Fare provider (dev/admin CLI probing only -- see "Accounts" above;
# /api/search itself never reads these, it always uses the caller's own
# stored key) ---
# auto = duffel iff DUFFEL_API_KEY is set, else serpapi iff SERPAPI_API_KEY
# is set, else mock. Explicit override: mock | serpapi | duffel
FARE_PROVIDER=auto
SERPAPI_API_KEY=
DUFFEL_API_KEY=

# --- Budget guard (live provider calls only; mock provider is free).
# Independent pools per provider -- only one provider is active at a time,
# but they cost differently per call (SerpApi ~$0.01-0.025/search flat,
# Duffel ~$0.005/search -- see README "Going live with Duffel"). Defaults
# below target a similar ~$25-40/month ceiling for either. ---
SERPAPI_DAILY_BUDGET=150
SERPAPI_MONTHLY_BUDGET=1500
DUFFEL_DAILY_BUDGET=200
DUFFEL_MONTHLY_BUDGET=5000
PER_SEARCH_LIVE_CAP=20
LIVE_DISCOVERY_CALLS_PER_SEARCH=6
VERIFY_TOP_N=16

# --- Cache TTLs (seconds) ---
FARE_CACHE_TTL_DISCOVERY=21600
FARE_CACHE_TTL_VERIFIED=1800
FARE_CACHE_TTL_EMPTY=3600
